<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:vTFMS.Converters"
             x:Class="vTFMS.App"
             xmlns:local="using:vTFMS"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml"/>
    <FluentTheme />
    <Style Selector="Button:disabled /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.6"/>
        <Setter Property="Foreground" Value="#040403"/>
    </Style>
    <Style Selector="TextBlock:disabled">
        <Setter Property="Opacity" Value="0.5"/>
        <Setter Property="Foreground" Value="#040403"/>
    </Style>
    <Style Selector="MenuItem:disabled /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.6"/>
        <Setter Property="Foreground" Value="#040403"/>
    </Style>
    <Style Selector="Label">
        <Setter Property="Foreground" Value="#040403"/>
    </Style>
    <Style Selector="RadioButton">
        <Setter Property="Foreground" Value="#040403"/>
    </Style>
    <Style Selector="RadioButton:disabled /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.6"/>
        <Setter Property="Foreground" Value="#040403"/>
    </Style>
    <Style Selector="ComboBox /template/ ContentPresenter">
        <Setter Property="Foreground" Value="#040403"/>
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="Foreground" Value="#040403"/>
    </Style>
    <Style Selector="SplitButton /template/ ContentPresenter">
        <Setter Property="Foreground" Value="#040403"/>
    </Style>
    <Style Selector="SplitButton:disabled /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.6"/>
        <Setter Property="Foreground" Value="#040403"/>
    </Style>
        <Style Selector="SplitButton /template/ Button /template/ ContentPresenter">
        <Setter Property="Foreground" Value="#040403"/>
    </Style>
    <Style Selector="SplitButton /template/ Button#PART_PrimaryButton /template/ ContentPresenter">
        <Setter Property="Foreground" Value="#040403"/>
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="Background" Value="White"/>
    </Style>
</Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <converters:PinIconConverter x:Key="PinIconConverter"/>
            <converters:HexToBrushConverter x:Key="HexToBrushConverter"/>
            <converters:HexToContrastBrushConverter x:Key="HexToContrastBrushConverter"/>
            <converters:BoolToCheckConverter x:Key="BoolToCheckConverter"/>
            <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
            <converters:BoolToVatsimTipConverter x:Key="BoolToVatsimTipConverter"/>
            <Color x:Key="PanelBackground">#ffe4c4</Color>
            <Color x:Key="PanelBorder">#ede9e3</Color>
            <Color x:Key="TitleBarBackground">#e1ddd8</Color>
            <Color x:Key="TitleBarBorder">#545454</Color>
            <Color x:Key="ForegroundPrimary">#040403</Color>
            <SolidColorBrush x:Key="PanelBackgroundBrush"
                Color="{StaticResource PanelBackground}"/>
            <SolidColorBrush x:Key="PanelBorderBrush"
                Color="{StaticResource PanelBorder}"/>
            <SolidColorBrush x:Key="TitleBarBackgroundBrush"
                Color="{StaticResource TitleBarBackground}"/>
            <SolidColorBrush x:Key="TitleBarBorderBrush"
                Color="{StaticResource TitleBarBorder}"/>
            <SolidColorBrush x:Key="ForegroundPrimaryBrush"
                Color="{StaticResource ForegroundPrimary}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>