<panels:BasePanelWindow
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:panels="using:vTFMS.Views.Panels"
    xmlns:vm="using:vTFMS.ViewModels.Panels"
    x:Class="vTFMS.Views.Panels.AdaptPanelWindow"
    x:DataType="vm:AdaptPanelViewModel"
    Width="680" Height="420"
    RequestedThemeVariant="Light">

  <StackPanel Margin="4">

    <!-- Force ComboBox dropdowns to be readable -->
    <StackPanel.Styles>
      <Style Selector="ComboBox /template/ Popup Border">
        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
      </Style>
      <Style Selector="ComboBoxItem">
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontFamily" Value="Arial"/>
        <Setter Property="FontSize" Value="11"/>
      </Style>
      <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#edcfaa"/>
      </Style>
    </StackPanel.Styles>

    <!-- Color grid: 4 rows × 3 columns -->
    <Grid ColumnDefinitions="*,*,*"
          RowDefinitions="Auto,Auto,Auto,Auto"
          Margin="8">

      <!-- Row 0 -->
      <StackPanel Grid.Row="0" Grid.Column="0"
                  Orientation="Horizontal" Margin="4,3"
                  HorizontalAlignment="Center">
        <Border Width="120" Height="22" CornerRadius="2"
                Background="{Binding BackgroundColor,
                  Converter={StaticResource HexToBrushConverter}}"
                BorderBrush="{StaticResource TitleBarBorderBrush}"
                BorderThickness="1" Cursor="Hand"
                Tag="BackgroundColor"
                PointerPressed="ColorButton_PointerPressed">
          <TextBlock Text="Background"
                     FontFamily="Arial" FontSize="11" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{Binding BackgroundColor,
                       Converter={StaticResource HexToContrastBrushConverter}}"/>
        </Border>
      </StackPanel>

      <StackPanel Grid.Row="0" Grid.Column="1"
                  Orientation="Horizontal" Margin="4,3"
                  HorizontalAlignment="Center">
        <Border Width="120" Height="22" CornerRadius="2"
                Background="{Binding BoundaryColor,
                  Converter={StaticResource HexToBrushConverter}}"
                BorderBrush="{StaticResource TitleBarBorderBrush}"
                BorderThickness="1" Cursor="Hand"
                Tag="BoundaryColor"
                PointerPressed="ColorButton_PointerPressed">
          <TextBlock Text="State/Country"
                     FontFamily="Arial" FontSize="11" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{Binding BoundaryColor,
                       Converter={StaticResource HexToContrastBrushConverter}}"/>
        </Border>
      </StackPanel>

      <StackPanel Grid.Row="0" Grid.Column="2"
                  Orientation="Horizontal" Margin="4,3"
                  HorizontalAlignment="Center">
        <Border Width="120" Height="22" CornerRadius="2"
                Background="{Binding TraconColor,
                  Converter={StaticResource HexToBrushConverter}}"
                BorderBrush="{StaticResource TitleBarBorderBrush}"
                BorderThickness="1" Cursor="Hand"
                Tag="TraconColor"
                PointerPressed="ColorButton_PointerPressed">
          <TextBlock Text="TRACON"
                     FontFamily="Arial" FontSize="11" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{Binding TraconColor,
                       Converter={StaticResource HexToContrastBrushConverter}}"/>
        </Border>
      </StackPanel>

      <!-- Row 1 -->
      <StackPanel Grid.Row="1" Grid.Column="0"
                  Orientation="Horizontal" Margin="4,3"
                  HorizontalAlignment="Center">
        <Border Width="120" Height="22" CornerRadius="2"
                Background="{Binding ArtccColor,
                  Converter={StaticResource HexToBrushConverter}}"
                BorderBrush="{StaticResource TitleBarBorderBrush}"
                BorderThickness="1" Cursor="Hand"
                Tag="ArtccColor"
                PointerPressed="ColorButton_PointerPressed">
          <TextBlock Text="ARTCC"
                     FontFamily="Arial" FontSize="11" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{Binding ArtccColor,
                       Converter={StaticResource HexToContrastBrushConverter}}"/>
        </Border>
      </StackPanel>

      <StackPanel Grid.Row="1" Grid.Column="1"
                  Orientation="Horizontal" Margin="4,3"
                  HorizontalAlignment="Center">
        <Border Width="120" Height="22" CornerRadius="2"
                Background="{Binding AirportColor,
                  Converter={StaticResource HexToBrushConverter}}"
                BorderBrush="{StaticResource TitleBarBorderBrush}"
                BorderThickness="1" Cursor="Hand"
                Tag="AirportColor"
                PointerPressed="ColorButton_PointerPressed">
          <TextBlock Text="All Airports"
                     FontFamily="Arial" FontSize="11" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{Binding AirportColor,
                       Converter={StaticResource HexToContrastBrushConverter}}"/>
        </Border>
      </StackPanel>

      <StackPanel Grid.Row="1" Grid.Column="2"
                  Orientation="Horizontal" Margin="4,3"
                  HorizontalAlignment="Center">
        <Border Width="120" Height="22" CornerRadius="2"
                Background="{Binding VorColor,
                  Converter={StaticResource HexToBrushConverter}}"
                BorderBrush="{StaticResource TitleBarBorderBrush}"
                BorderThickness="1" Cursor="Hand"
                Tag="VorColor"
                PointerPressed="ColorButton_PointerPressed">
          <TextBlock Text="VOR"
                     FontFamily="Arial" FontSize="11" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{Binding VorColor,
                       Converter={StaticResource HexToContrastBrushConverter}}"/>
        </Border>
      </StackPanel>

      <!-- Row 2 -->
      <StackPanel Grid.Row="2" Grid.Column="0"
                  Orientation="Horizontal" Margin="4,3"
                  HorizontalAlignment="Center">
        <Border Width="120" Height="22" CornerRadius="2"
                Background="{Binding NdbColor,
                  Converter={StaticResource HexToBrushConverter}}"
                BorderBrush="{StaticResource TitleBarBorderBrush}"
                BorderThickness="1" Cursor="Hand"
                Tag="NdbColor"
                PointerPressed="ColorButton_PointerPressed">
          <TextBlock Text="NDB"
                     FontFamily="Arial" FontSize="11" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{Binding NdbColor,
                       Converter={StaticResource HexToContrastBrushConverter}}"/>
        </Border>
      </StackPanel>

      <StackPanel Grid.Row="2" Grid.Column="1"
                  Orientation="Horizontal" Margin="4,3"
                  HorizontalAlignment="Center">
        <Border Width="120" Height="22" CornerRadius="2"
                Background="{Binding FixColor,
                  Converter={StaticResource HexToBrushConverter}}"
                BorderBrush="{StaticResource TitleBarBorderBrush}"
                BorderThickness="1" Cursor="Hand"
                Tag="FixColor"
                PointerPressed="ColorButton_PointerPressed">
          <TextBlock Text="Departure Fix"
                     FontFamily="Arial" FontSize="11" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{Binding FixColor,
                       Converter={StaticResource HexToContrastBrushConverter}}"/>
        </Border>
      </StackPanel>

      <StackPanel Grid.Row="2" Grid.Column="2"
                  Orientation="Horizontal" Margin="4,3"
                  HorizontalAlignment="Center">
        <Border Width="120" Height="22" CornerRadius="2"
                Background="{Binding JetRoutesColor,
                  Converter={StaticResource HexToBrushConverter}}"
                BorderBrush="{StaticResource TitleBarBorderBrush}"
                BorderThickness="1" Cursor="Hand"
                Tag="JetRoutesColor"
                PointerPressed="ColorButton_PointerPressed">
          <TextBlock Text="Jet Routes"
                     FontFamily="Arial" FontSize="11" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{Binding JetRoutesColor,
                       Converter={StaticResource HexToContrastBrushConverter}}"/>
        </Border>
      </StackPanel>

      <!-- Row 3 -->
      <StackPanel Grid.Row="3" Grid.Column="0"
                  Orientation="Horizontal" Margin="4,3"
                  HorizontalAlignment="Center">
        <Border Width="120" Height="22" CornerRadius="2"
                Background="{Binding VictorRoutesColor,
                  Converter={StaticResource HexToBrushConverter}}"
                BorderBrush="{StaticResource TitleBarBorderBrush}"
                BorderThickness="1" Cursor="Hand"
                Tag="VictorRoutesColor"
                PointerPressed="ColorButton_PointerPressed">
          <TextBlock Text="Victor Routes"
                     FontFamily="Arial" FontSize="11" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{Binding VictorRoutesColor,
                       Converter={StaticResource HexToContrastBrushConverter}}"/>
        </Border>
      </StackPanel>

      <StackPanel Grid.Row="3" Grid.Column="1"
                  Margin="4,3"
                  HorizontalAlignment="Center">
        <Border Width="120" Height="22" CornerRadius="2"
                Background="{Binding DataBlockColor,
                  Converter={StaticResource HexToBrushConverter}}"
                BorderBrush="{StaticResource TitleBarBorderBrush}"
                BorderThickness="1" Cursor="Hand"
                Tag="DataBlockColor"
                PointerPressed="ColorButton_PointerPressed">
          <TextBlock Text="Flight DataBlock"
                     FontFamily="Arial" FontSize="11" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{Binding DataBlockColor,
                       Converter={StaticResource HexToContrastBrushConverter}}"/>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                    HorizontalAlignment="Center">
          <ComboBox ItemsSource="{Binding AvailableFonts}"
                    SelectedItem="{Binding DataBlockFont}"
                    FontFamily="Arial" FontSize="10"
                    Foreground="Black"
                    Width="120" Height="24"
                    Padding="4,2"/>
          <ComboBox ItemsSource="{Binding AvailableSizes}"
                    SelectedItem="{Binding DataBlockFontSize}"
                    FontFamily="Arial" FontSize="10"
                    Foreground="Black"
                    Width="65" Height="24"
                    Padding="4,2" Margin="4,0,0,0"/>
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Row="3" Grid.Column="2"
                  Margin="4,3"
                  HorizontalAlignment="Center">
        <Border Width="120" Height="22" CornerRadius="2"
                Background="{Binding MapLabelColor,
                  Converter={StaticResource HexToBrushConverter}}"
                BorderBrush="{StaticResource TitleBarBorderBrush}"
                BorderThickness="1" Cursor="Hand"
                Tag="MapLabelColor"
                PointerPressed="ColorButton_PointerPressed">
          <TextBlock Text="Map Labels"
                     FontFamily="Arial" FontSize="11" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{Binding MapLabelColor,
                       Converter={StaticResource HexToContrastBrushConverter}}"/>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                    HorizontalAlignment="Center">
          <ComboBox ItemsSource="{Binding AvailableFonts}"
                    SelectedItem="{Binding MapLabelFont}"
                    FontFamily="Arial" FontSize="10"
                    Foreground="Black"
                    Width="120" Height="24"
                    Padding="4,2"/>
          <ComboBox ItemsSource="{Binding AvailableSizes}"
                    SelectedItem="{Binding MapLabelFontSize}"
                    FontFamily="Arial" FontSize="10"
                    Foreground="Black"
                    Width="65" Height="24"
                    Padding="4,2" Margin="4,0,0,0"/>
        </StackPanel>
      </StackPanel>

    </Grid>

    <!-- Bottom buttons -->
    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,8,0,0">
      <Button Content="OK" Command="{Binding OkCommand}"
              FontFamily="Arial" FontSize="11"
              MinWidth="60" Margin="4"/>
      <Button Content="Cancel" Command="{Binding CancelCommand}"
              FontFamily="Arial" FontSize="11"
              MinWidth="60" Margin="4"/>
    </StackPanel>

  </StackPanel>

</panels:BasePanelWindow>