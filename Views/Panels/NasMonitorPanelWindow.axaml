<panels:BasePanelWindow
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:panels="using:vTFMS.Views.Panels"
    xmlns:vm="using:vTFMS.ViewModels.Panels"
    x:Class="vTFMS.Views.Panels.NasMonitorPanelWindow"
    x:DataType="vm:NasMonitorPanelViewModel"
    Width="600" Height="400"
    MinWidth="300" MinHeight="200">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="4">

    <!-- Row 0: Top toolbar — Enable/Disable and horizon slider -->
    <Grid Grid.Row="0"
          ColumnDefinitions="Auto,*,Auto,Auto"
          Margin="4,4,4,4">
      <SplitButton Grid.Column="0"
             Content="{Binding EnableButtonText}"
             Command="{Binding ToggleEnableCommand}"
             FontFamily="Arial" FontSize="11"
             Margin="0,0,8,0">
        <SplitButton.Flyout>
          <MenuFlyout>
            <MenuItem Header="{Binding EnableButtonText}"
                      Command="{Binding ToggleEnableCommand}"/>
            <Separator/>
            <MenuItem Header="Save"
                      Command="{Binding SaveCommand}"/>
            <MenuItem Header="Save As"
                      Command="{Binding SaveAsCommand}"/>
            <MenuItem Header="Load"
                      Command="{Binding LoadCommand}"/>
          </MenuFlyout>
        </SplitButton.Flyout>
      </SplitButton>

      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  VerticalAlignment="Center">
        <TextBlock Text="Horizon:"
                   FontFamily="Arial" FontSize="11"
                   VerticalAlignment="Center"
                   Margin="0,0,6,0"/>
        <Slider x:Name="HorizonSlider"
                Minimum="60" Maximum="480"
                Value="{Binding HorizonMinutes}"
                TickFrequency="15"
                IsSnapToTickEnabled="True"
                Width="150"
                VerticalAlignment="Center"
                PointerReleased="HorizonSlider_PointerReleased"/>
        <TextBlock Text="{Binding #HorizonSlider.Value,
                     StringFormat={}{0:0} min}"
                   FontFamily="Arial" FontSize="11"
                   VerticalAlignment="Center"
                   Margin="6,0,0,0"
                   Width="50"/>
      </StackPanel>

      <TextBlock Grid.Column="2"
                 Text="⚠ &gt;3hr: high resource usage"
                 FontFamily="Arial" FontSize="10"
                 Foreground="#CC6600"
                 FontWeight="Bold"
                 VerticalAlignment="Center"
                 Margin="8,0,0,0"
                 IsVisible="{Binding ShowResourceWarning}"/>
    </Grid>

    <!-- Row 1: View selector toolbar -->
    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                Margin="4,0,4,4"
                Spacing="8">
      <TextBlock Text="View:"
                 FontFamily="Arial" FontSize="11"
                 VerticalAlignment="Center"/>
      <RadioButton x:Name="SummaryViewRadio"
                   Content="Summary"
                   FontFamily="Arial" FontSize="11"
                   IsChecked="True"
                   GroupName="ViewMode"
                   VerticalAlignment="Center"
                   Checked="SummaryView_Checked"/>
      <RadioButton x:Name="SectorViewRadio"
                   Content="Sector"
                   FontFamily="Arial" FontSize="11"
                   GroupName="ViewMode"
                   VerticalAlignment="Center"
                   Checked="SectorView_Checked"/>
      <ComboBox x:Name="ArtccSelector"
                FontFamily="Arial" FontSize="11"
                Width="80"
                IsVisible="False"
                SelectionChanged="ArtccSelector_SelectionChanged"/>
    </StackPanel>

    <!-- Row 2: Sector toolbar — only visible in sector view -->
    <StackPanel Grid.Row="2"
                x:Name="SectorToolbar"
                Orientation="Horizontal"
                Margin="4,0,4,4"
                Spacing="8"
                IsVisible="False">
      <Button Content="Combine Sectors"
              FontFamily="Arial" FontSize="11"
              Click="CombineSectors_Click"/>
      <Button x:Name="HideBaselinesBtn"
              Content="Hide All Baselines"
              FontFamily="Arial" FontSize="11"
              Click="HideBaselines_Click"/>
    </StackPanel>

    <!-- Row 3: Column headers -->
    <ScrollViewer Grid.Row="3"
                  HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollBarVisibility="Disabled"
                  x:Name="HeaderScroll">
      <ItemsControl x:Name="HeaderRow"
                    FontFamily="Courier New"
                    FontSize="11"
                    FontWeight="Bold"/>
    </ScrollViewer>

    <!-- Row 4: Data rows -->
    <ScrollViewer Grid.Row="4"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  x:Name="DataScroll">
      <ItemsControl x:Name="DataRows"
                    FontFamily="Courier New"
                    FontSize="11"/>
    </ScrollViewer>

  </Grid>
</panels:BasePanelWindow>